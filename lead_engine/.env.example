# lead_engine environment configuration. Copy to .env and fill in.

# Anthropic (optional) — enables LLM mode in the slot drafter; template mode works without it.
ANTHROPIC_API_KEY=

# Notion — required for `--sync` steps of draft/enrich.
# Single database: "Precision Assembly Leads"
# Token: https://www.notion.so/my-integrations
NOTION_TOKEN=
NOTION_DATABASE_ID=

# Findymail (required for `enrich`) — email find + verify only, no phone endpoints.
# Get the key from Settings/API: https://app.findymail.com
FINDYMAIL_API_KEY=

# Optional end-of-run email summaries (stdlib smtplib, STARTTLS).
# Gmail: create an app password at https://myaccount.google.com/apppasswords
# (2FA required) and use it as SMTP_PASSWORD with smtp.gmail.com:587.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
NOTIFY_TO_ADDRESS=
